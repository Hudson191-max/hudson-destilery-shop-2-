# The Hudson Distillery — environment template.
# Copy to .env.local and fill in. Never commit real values.

# Production database (Supabase, server-side only). Leave both empty to run the
# local SQLite fallback via Prisma.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# REQUIRED in production: HMAC key that signs the staff session cookie.
# Generate one with: openssl rand -base64 32
HD_SESSION_SECRET=

# Bearer token Vercel Cron sends to /api/cron/backup (daily backup job).
CRON_SECRET=

# Only needed for the local Prisma/SQLite fallback (development).
# DATABASE_URL="file:./dev.db"
